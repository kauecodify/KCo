# KCo Environment Configuration
# Old But Gold TR8 IVSTO | Pre-Seed: $30M+ USD
# Copy this file to .env and fill in your values

# ==================== Environment ====================
ENVIRONMENT=development
DEBUG=True

# ==================== API Configuration ====================
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=v1

# ==================== Database Configuration ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kco_development
DB_USER=kco_admin
DB_PASSWORD=kco_secure_password
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ==================== Redis Configuration ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==================== LOWDATAESC Integration ====================
LOWDATAESC_API_URL=https://api.lowdataesc.com
LOWDATAESC_API_KEY=your_lowdataesc_api_key_here
LOWDATAESC_TIMEOUT=30

# ==================== Fleet Configuration ====================
FLEET_BRAZIL_MAX=500
FLEET_MEXICO_MAX=500
FLEET_GROWTH_MONTHLY=0.15

# ==================== Image Processing ====================
IMAGE_PROCESSING_ENABLED=True
IMAGE_MAX_SIZE_MB=10
IMAGE_FORMATS=jpg,jpeg,png,webp

# ==================== AI/ML Configuration ====================
ML_MODELS_PATH=./ML/models
ML_INFERENCE_TIMEOUT=60

# ==================== Financial Projections ====================
PRE_SEED_TARGET=30000000
MONTHLY_REVENUE_BRAZIL=1500000
MONTHLY_REVENUE_MEXICO=1200000
ROI_TARGET=3.5

# ==================== Security ====================
SECRET_KEY=kco-old-but-gold-tr8-ivsto-2024-change-this
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE_HOURS=24

# ==================== Language ====================
SUPPORTED_LANGUAGES=pt,es
DEFAULT_LANGUAGE=pt

# ==================== Message Queue ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=kco_user
RABBITMQ_PASSWORD=kco_secure_password

# ==================== Monitoring ====================
PROMETHEUS_ENABLED=True
GRAFANA_ENABLED=True

# ==================== Logging ====================
LOG_LEVEL=INFO
LOG_FORMAT=json
